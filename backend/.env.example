# Configurações do Servidor
ENVIRONMENT=development
PORT=8000

# Meta WhatsApp Cloud API (Obtidas no developers.facebook.com)
META_VERIFY_TOKEN=gere_um_token_aleatorio_e_configure_o_mesmo_na_Meta
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# Provedores de IA
# Obtenha sua chave gratuita em https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Caso utilize Ollama local para desenvolvimento
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
